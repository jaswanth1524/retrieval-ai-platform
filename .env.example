# Runtime
PYTHON_VERSION=3.12
APP_ENV=local
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Qdrant
QDRANT_IMAGE=qdrant/qdrant:latest
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=docrag_documents
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse
QDRANT_DENSE_VECTOR_SIZE=384

# Retrieval
RRF_K=60
DENSE_RETRIEVAL_LIMIT=50
SPARSE_RETRIEVAL_LIMIT=50
FUSED_TOP_N=50
RERANK_TOP_K=8
RERANKER_BATCH_SIZE=64
MAX_CONTEXT_CHUNKS=6
# Cross-encoder logits are sigmoid-normalized to [0, 1] before comparing against this
# floor; chunks scoring below it never reach the LLM context or citations, however
# high they ranked in fusion. 0.30 only drops chunks the reranker actively considers
# irrelevant.
RERANK_MIN_SCORE=0.30

# Local embedding and reranking (embeddings always run locally; there is no
# provider switch here by design — see CLAUDE.md's provider rules)
DENSE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_EMBEDDING_MODEL=Qdrant/BM25
# jina-reranker-v2-base-multilingual is the strongest cross-encoder fastembed
# supports (~1.1 GB, downloaded once on first use). BAAI/bge-reranker-v2-m3 is NOT
# loadable by fastembed at any version — do not set it here.
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
EMBEDDING_MODEL_TAG=fastembed:BAAI/bge-small-en-v1.5

# Generation via LiteLLM
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512
# Raise this for larger local models; also raise LONG_RUNNING_TIMEOUT_MS in
# frontend/src/api/client.ts to match.
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_NUM_RETRIES=0
# host.docker.internal only resolves from *inside* a Docker container. If the API
# runs directly on your host (not via `docker compose`), set this to
# http://localhost:11434 instead — the value below is for the Docker Compose path.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional OpenAI generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Document ingestion
MAX_UPLOAD_BYTES=52428800
# CHUNK_SIZE_TOKENS counts whitespace-delimited words, not embedding-model subword
# tokens; 300 stays safely under bge-small's 512-subword-token limit after expansion.
# Changing this invalidates the index — re-ingest documents after changing it.
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_TOKENS=75
# Markdown heading sections under this word count are folded into a neighboring
# section before chunking, instead of becoming their own low-information chunk.
MIN_SECTION_WORDS=40

# CORS (fallback only — dev uses the Vite proxy, prod serves the frontend
# same-origin; only needed if a separately-running frontend calls this API
# directly, e.g. CORS_ALLOW_ORIGINS=["http://localhost:5173"])
CORS_ALLOW_ORIGINS=[]

# Optional: force the embedding + reranker models to load once at startup instead of
# lazily on the first request. Off by default — see AppSettings.warmup_models for why.
WARMUP_MODELS=false

# Runtime
# Verbosity of the app's own loggers (api.* and eval.*): CRITICAL/ERROR/WARNING/INFO/DEBUG.
# Applied via dictConfig at app startup; does not touch uvicorn's own loggers.
LOG_LEVEL=INFO
# text (default) or json: one JSON object per line, with the request id.
LOG_FORMAT=text

# API
# Host port and address docker-compose publishes the API on (compose-only; AppSettings
# has no such fields — inside the container the API always binds 0.0.0.0:8000 per the
# Dockerfile CMD). The address defaults to loopback: set API_BIND=0.0.0.0 to reach the
# UI from other devices, and set API_KEY when you do.
API_PORT=8000
API_BIND=127.0.0.1
# Optional single shared API key. Empty (default) leaves every route open. When set,
# every /documents* route (list, upload, delete, content, original, jobs, reindex,
# tags), /questions*, /search, /traces*, /feedback, /export, /import, /access,
# /metrics and the OpenAPI docs require a matching X-API-Key header
# (checked before a request body is read) — so a Prometheus scraper needs the
# header in its scrape config. Only /health, /health/ready, and /config stay open, so
# container healthchecks, probes, and the UI's own boot request (which has to succeed
# before there's anywhere to type a key) keep working either way.
# Not multi-user auth — one key for the whole API.
API_KEY=
# Optional read-only key (needs API_KEY too, and must differ): it can ask questions and
# read documents, traces and jobs, but uploading, deleting, re-indexing, tagging,
# GET /export, POST /import, GET /feedback and /metrics answer 403 to it. For sharing the UI with
# people who should use the corpus but not change it.
API_READ_KEY=

# Qdrant
QDRANT_IMAGE=qdrant/qdrant:v1.19.1
# Host ports compose publishes Qdrant on. QDRANT_GRPC_PORT is also the port the API
# dials for gRPC when it runs on the host (in compose the API always uses 6334).
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=docrag_documents
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse
QDRANT_DENSE_VECTOR_SIZE=384
# gRPC avoids per-call JSON (de)serialization versus Qdrant's REST API. Requires the
# gRPC port above to be reachable from wherever the API process runs.
QDRANT_PREFER_GRPC=false
# Qdrant's own API key. Compose publishes Qdrant's ports on 127.0.0.1 only; set this
# (and uncomment QDRANT__SERVICE__API_KEY in docker-compose.yml, which makes Qdrant
# require it) if anything else can reach them. Empty (default): no key is sent.
QDRANT_API_KEY=

# Retrieval
RRF_K=60
DENSE_RETRIEVAL_LIMIT=50
SPARSE_RETRIEVAL_LIMIT=50
FUSED_TOP_N=50
# How many of the fused top-N candidates are actually sent through the (expensive)
# cross-encoder reranker. Clamped to FUSED_TOP_N — lower this to cut rerank latency
# without changing how many candidates fusion itself produces.
#
# This is the single largest latency knob in the whole query path, and its cost is
# LINEAR in this value. Measured on an 80-chunk corpus, 8 CPU cores in Docker, against
# the default reranker: 50 candidates cost ~52s of a ~66s question (79% of total
# latency), 20 cost ~15s. With RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2 the same
# 20 cost ~2.6s. Selected context chunks were unchanged at 20 vs 50 on that corpus, so
# the coverage given up was real but unused — re-check that on your own corpus before
# assuming it holds, because a lower value can only ever narrow what rerank can see.
RERANK_CANDIDATES=50
RERANK_TOP_K=8
# Query-document pairs scored per cross-encoder forward pass. This value ALONE bounds
# the reranker's peak memory — not its ratio to RERANK_CANDIDATES. Measured over 50
# candidates of ~448 tokens: batch 8 peaked at 2.66 GB (the loaded-model baseline, so
# scoring costs nothing extra), batch 16 at 3.53 GB, batch 50 at 6.33 GB, which
# OOM-kills the container on a default ~6 GB Docker Desktop. Latency is flat across the
# whole range, so a bigger batch buys no speed and no answer quality. Raise it only
# against known memory headroom; the API logs a warning at startup past 8.
# Keeping it <= RERANK_CANDIDATES is a separate, weaker rule: above that batching is
# just a no-op. Satisfying it does not make you safe — batch 50 with 50 candidates
# satisfies it and still peaks at 6.33 GB.
RERANKER_BATCH_SIZE=8
# Rerank scores memoized per (query, passage). Regenerate/Retry re-ask the identical
# query, so a cache hit skips the costliest stage entirely. 0 disables.
RERANK_CACHE_SIZE=4096
# ONNX Runtime threads per session; 0 = ORT default (all cores). Lowering these makes a
# single question SLOWER — they exist to stop ingest embedding and query-time rerank
# oversubscribing the same cores when uploads and questions overlap.
EMBEDDING_THREADS=0
RERANKER_THREADS=0
MAX_CONTEXT_CHUNKS=6
# After rerank, each selected chunk's generation context is expanded with up to this
# many neighboring chunks on each side (small-to-big retrieval). 0 disables it.
CONTEXT_NEIGHBOR_RADIUS=1
# Caps the neighbour text added on each side of a chunk, in characters (the text
# nearest the chunk is kept): less prompt, so the first token comes sooner. 0 = no cap.
CONTEXT_NEIGHBOR_MAX_CHARS=0
# Post-rerank dedup: drop a survivor that near-duplicates a higher-ranked kept chunk
# (same-doc ordinal neighbor, or word-shingle Jaccard >= the similarity below), refilling
# from lower-ranked survivors. Pure selection — rerank scores/order are untouched.
CONTEXT_DIVERSITY_ENABLED=true
CONTEXT_DIVERSITY_MAX_SIMILARITY=0.6
# Cross-encoder logits are sigmoid-normalized to [0, 1] before comparing against this
# floor; chunks scoring below it never reach the LLM context or citations, however
# high they ranked in fusion. 0.15 blocks clearly off-topic chunks while still
# letting paraphrase-level (not exact-phrase) matches through — see api/settings.py
# for the real-world calibration trace behind this default. Measured on the handbook
# corpus (eval/datasets/*_eval.jsonl, jina int8): questions it can't answer top out at
# ~0.04 (off-topic) and ~0.065 (on-topic, e.g. "What dental plan do we get?"), while
# loose paraphrases of an answer score 0.08-0.10 — 0.15 drops those (3/8 of
# paraphrase_eval.jsonl found at 0.15, 7/8 at 0.07). Lower it only after measuring on
# your own corpus: the margin is thin, and int8 scores shift slightly between CPUs.
# Set for the default reranker; another model's scores sit on another scale (the
# server warns at startup when RERANKER_MODEL changes and this doesn't).
RERANK_MIN_SCORE=0.15
# When no passage clears RERANK_MIN_SCORE, this many of the best-ranked ones are sent to
# the model anyway, marked as weak matches: it answers from them only if they state the
# answer, else it says the documents don't cover it (the answer carries weak_matches,
# shown as "weak match"). Each reranker scores on its own scale, so a fixed floor
# refused questions the documents answer ("what are foundational models": 0.006 with
# MiniLM, 0.154 with jina). 0 refuses at once without asking the model.
RERANK_FALLBACK_COUNT=3

# Local embedding and reranking (embeddings always run locally; there is no
# provider switch here by design — see CLAUDE.md's provider rules)
DENSE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_EMBEDDING_MODEL=Qdrant/BM25
# jina-reranker-v2-base-multilingual is the strongest cross-encoder fastembed
# supports. BAAI/bge-reranker-v2-m3 is NOT loadable by fastembed at any version — do
# not set it here.
#
# It is also, by a wide margin, the most expensive stage of a question. Measured on a
# 158-chunk corpus, 7 questions (5 English, 1 Spanish, 1 French), Docker on an M1:
#   jina fp32   20 cands 11.7s  50 cands 31.2s  2.3 GB
#   jina int8   20 cands  4.6s  50 cands 12.7s  1.4 GB  81-83% same top-6, 0/7 lost
#   MiniLM-L-6  20 cands  1.7s  50 cands  4.3s  0.8 GB  43-45% same top-6, 2/7 lost
# ("lost" = no candidate cleared RERANK_MIN_SCORE, so the answer was "insufficient
# context"; one of MiniLM's was the Spanish question — it is English-only). Different
# cross-encoders put logits on different scales, so if you switch models re-check how
# many chunks clear RERANK_MIN_SCORE (GET /traces/{id} shows rerank_score and
# drop_reason) rather than assuming 0.15 transfers.
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
# Which ONNX export to load. "auto": jina's int8 export (~0.28 GB download vs 1.1 GB
# fp32), fastembed's registered file for any other model. Empty: always the registered
# file (jina: fp32 onnx/model.onnx). Or a path in the model repo, e.g.
# onnx/model_quantized.onnx.
RERANKER_ONNX_FILE=auto
EMBEDDING_MODEL_TAG=fastembed:BAAI/bge-small-en-v1.5
# Prepended to the dense query (not the corpus) before embedding. Defaults to
# bge-small's recommended instruction, "Represent this sentence for searching relevant
# passages: " (with its trailing space, which an env file line can't show reliably).
# Query-side only, so changing it needs no re-ingest. Set empty to disable.
# DENSE_QUERY_INSTRUCTION=
# Prepended to corpus text only, before dense embedding ("passage: " for e5 models).
DENSE_PASSAGE_PREFIX=
# BM25's stemmer language (english, german, french, spanish, italian, dutch, ...).
SPARSE_LANGUAGE=english
#
# Multilingual profile (opt-in; a new vector space, so re-index — see README
# "Multilingual documents"). Either model, with the matching tag and size:
#   DENSE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#   EMBEDDING_MODEL_TAG=fastembed:paraphrase-multilingual-MiniLM-L12-v2
#   QDRANT_DENSE_VECTOR_SIZE=384
#   DENSE_QUERY_INSTRUCTION=
# or, stronger and heavier (2.2 GB, ~100 languages):
#   DENSE_EMBEDDING_MODEL=intfloat/multilingual-e5-large
#   EMBEDDING_MODEL_TAG=fastembed:multilingual-e5-large
#   QDRANT_DENSE_VECTOR_SIZE=1024
#   DENSE_QUERY_INSTRUCTION=query: 
#   DENSE_PASSAGE_PREFIX=passage: 
# and SPARSE_LANGUAGE for the corpus's main language. The reranker is multilingual already.

# Generation via LiteLLM: ollama (default), openai, openai_compatible or anthropic (below)
LLM_PROVIDER=ollama
# Providers a question may switch to per request, as a JSON list. Unset: any configured
# provider (LLM_PROVIDER is always allowed). Set it to stop callers picking a paid one:
# ALLOWED_REQUEST_PROVIDERS=["ollama"]
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512
# Bounds each LLM call only (condense, generation, citation retry), not the whole
# question — retrieval and reranking run before it, so a question can take longer
# than this before the timeout error arrives. Raise it for larger local models. The UI
# waits on streamed answers while tokens keep arriving (STREAM_IDLE_TIMEOUT_MS, 180s
# of silence); only the non-streaming path is capped at LONG_RUNNING_TIMEOUT_MS
# (frontend/src/api/client.ts), so raise that too if you use it.
LLM_REQUEST_TIMEOUT_SECONDS=60
# Ollama and OpenAI-compatible servers send nothing while they read the prompt, so a
# long prompt on modest hardware hit the timeout above before its first token. Each
# local call's timeout adds its estimated prompt tokens divided by this rate (or the
# slower rate this server has been measured at), e.g. 60s + 6000/40 = 210s for a long
# question. 0 = a flat LLM_REQUEST_TIMEOUT_SECONDS. Hosted providers never scale.
LLM_PREFILL_TOKENS_PER_SECOND=40
LLM_NUM_RETRIES=0
# host.docker.internal only resolves from *inside* a Docker container. If the API
# runs directly on your host (not via `docker compose`), set this to
# http://localhost:11434 instead — the value below is for the Docker Compose path.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# How long Ollama keeps the model loaded in memory after the last request. Without
# this, Ollama's own 5-minute default unloads the model and the next question pays a
# multi-second reload; raise further for always-on deployments, lower to free RAM
# sooner on shared/constrained hosts.
OLLAMA_KEEP_ALIVE=30m
# Context window (tokens) requested from Ollama; 0 lets Ollama choose (recent Ollama
# uses the model's full trained context, e.g. 32768 for qwen2.5). This is a memory
# knob, not a speed knob: on an M1, 8192 left prefill/decode speed unchanged but cut
# qwen2.5's resident size from 8.2 GB to 5.3 GB. Too small truncates the FRONT of the
# prompt — the grounding rules go first — so keep room for 6 context chunks plus
# history (~8192 minimum). When set, the prompt is also fitted to it (see below).
OLLAMA_NUM_CTX=0
# LLM calls this process sends Ollama at once; the rest wait here (the UI shows
# "waiting for the model") and their timeout starts only once sent. Ollama answers one
# request at a time by default, and a request queued inside Ollama timed out unread.
# Raise it with Ollama's own OLLAMA_NUM_PARALLEL; 0 = no limit.
OLLAMA_MAX_PARALLEL=1
# The generation model's context window in tokens. When known — this, or OLLAMA_NUM_CTX
# for Ollama — the prompt drops the lowest-ranked sources, then the oldest history,
# until it fits with LLM_MAX_TOKENS to spare, instead of the model server cutting off
# its front (the grounding rules). 0 (default): OLLAMA_NUM_CTX for Ollama; for OpenAI and
# Anthropic models, the window LiteLLM's model table lists; else no fitting.
LLM_CONTEXT_WINDOW=0
# Dense vectors also kept as int8 in RAM ("scalar": about a quarter of the memory for a
# big corpus), with the top candidates re-scored against the full vectors (oversampled
# this many times). "none" (default): full vectors only. Applied in place, no re-index.
QDRANT_QUANTIZATION=none
QDRANT_QUANTIZATION_OVERSAMPLING=2.0

# Finished answers are cached per process for repeat questions (same question, scope,
# settings and corpus), skipping retrieval and the LLM. Any upload, delete or tag
# change invalidates every entry; questions with chat history are never cached, and
# Regenerate always asks again. 0 turns the cache off.
ANSWER_CACHE_SIZE=256
ANSWER_CACHE_TTL_SECONDS=3600
# Questions answered at once. Past this a question gets 429 + Retry-After immediately
# instead of tying up a request thread for a minute. 0 = no cap.
MAX_CONCURRENT_QUESTIONS=4
# Of those, how many may be summaries or comparisons, which run for minutes; the rest
# stay free for questions. 0 = no separate cap.
MAX_CONCURRENT_SUMMARIES=2
# The language answers and summaries are written in: empty = the model's choice,
# "match" = the question's language (useful for a corpus in several languages), or a
# language name such as German.
ANSWER_LANGUAGE=
# Requests per minute per client that change something (questions, searches, uploads,
# feedback, deletes...) or carry a wrong API key; past it, 429 + Retry-After. Reads and
# upload progress polls are never limited. Behind a reverse proxy, set
# FORWARDED_ALLOW_IPS below so the client is the real one, not the proxy. 0 = off.
RATE_LIMIT_PER_MINUTE=0
# Read by uvicorn, not DocRAG: the reverse proxy addresses whose X-Forwarded-For header
# to trust, comma-separated (in Docker, the proxy as the API container sees it — often
# the compose network's gateway). Unset, every request appears to come from the proxy,
# so all users share one rate-limit bucket and logs show the proxy's address.
# FORWARDED_ALLOW_IPS=172.18.0.1

# Optional self-hosted OpenAI-compatible server (vLLM, llama.cpp's server, LM Studio,
# LocalAI), used with LLM_PROVIDER=openai_compatible or picked per question in the UI.
# The base URL is the one ending in /v1; the key is optional for most local servers.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=

# Optional OpenAI generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Reasoning models (gpt-5 family, o-series) spend hidden reasoning tokens from the
# same budget as the visible answer. OPENAI_REASONING_EFFORT tunes that spend
# (minimal|low|medium|high, or empty for the provider default); it is only sent to
# models LiteLLM reports as reasoning-capable. REASONING_TOKEN_HEADROOM is added on
# top of LLM_MAX_TOKENS for those models so reasoning can't starve the answer — with
# a 512 budget, reasoning alone consumes it all and the answer comes back empty.
OPENAI_REASONING_EFFORT=low
REASONING_TOKEN_HEADROOM=3072

# Separate corpora on one server, chosen per request (the X-Workspace header; the UI's
# workspace menu). Each is its own Qdrant collection and originals directory. Off by
# default; without the header the default workspace (QDRANT_COLLECTION) is used.
WORKSPACES_ENABLED=false

# Keep the index in step with a folder (see WATCH_WORKSPACE). Off when empty. Each
# WATCH_INTERVAL_SECONDS, new or changed supported files are indexed like uploads;
# WATCH_DELETE_MISSING also deletes documents whose files were removed from it.
WATCH_DIR=
WATCH_INTERVAL_SECONDS=30
WATCH_DELETE_MISSING=false
# A file whose read or indexing job fails is tried again after WATCH_INTERVAL_SECONDS
# x 2^n (at most WATCH_RETRY_MAX_SECONDS), up to WATCH_MAX_RETRIES times; after that it
# waits until the file changes. GET /watch lists what is retrying and what gave up.
WATCH_MAX_RETRIES=3
WATCH_RETRY_MAX_SECONDS=3600
# The workspace it indexes into (needs WORKSPACES_ENABLED; created at startup if
# missing). Empty = the default workspace.
WATCH_WORKSPACE=

# Index a document from a URL (POST /documents/from-url; the corpus panel's "From URL").
# Off by default. The server fetches it, so only public addresses are allowed unless
# URL_INGEST_ALLOW_PRIVATE is set (a private address could reach Qdrant or cloud
# metadata from inside the deployment). MAX_UPLOAD_BYTES caps the download.
URL_INGEST_ENABLED=false
URL_INGEST_ALLOW_PRIVATE=false
URL_INGEST_TIMEOUT_SECONDS=30

# Whole-document summaries and comparisons (POST /questions/summary). A document is
# read in parts of at most SUMMARY_BATCH_CHARS characters (fewer when LLM_CONTEXT_WINDOW
# or OLLAMA_NUM_CTX is set), at most SUMMARY_MAX_BATCHES parts per request (each part is
# one LLM call; a longer document is read at evenly spaced passages).
# SUMMARY_MAX_TOKENS is the final answer's output budget.
SUMMARY_BATCH_CHARS=9000
SUMMARY_MAX_BATCHES=8
SUMMARY_MAX_TOKENS=1024
# Parts turned into notes at once with a hosted provider (Ollama: always one at a time),
# and the most documents one brief ("mode": "brief") may cover (at most 10; lowered to
# SUMMARY_MAX_BATCHES when that is smaller, since each document takes at least one part).
SUMMARY_PARALLEL_PARTS=4
SUMMARY_MAX_DOCUMENTS=5

# Optional Anthropic (Claude) generation, used with LLM_PROVIDER=anthropic or picked
# per question in the UI. Hosted and optional: uploads and indexing never call it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Document ingestion
MAX_UPLOAD_BYTES=52428800
# Largest backup zip POST /import accepts (each original inside: MAX_UPLOAD_BYTES).
MAX_IMPORT_BYTES=268435456
# CHUNK_SIZE_TOKENS counts the dense model's real subword tokens (the chunker uses the
# model's own tokenizer). Windows never exceed this budget minus the contextual-embedding
# prefix, so the embedded string stays under bge-small's 512-token limit. Changing this
# alters chunk contents — re-upload documents afterward so old/new chunks stay consistent.
CHUNK_SIZE_TOKENS=448
CHUNK_OVERLAP_TOKENS=100
# Markdown heading sections under this word count are folded into a neighboring
# section before chunking, instead of becoming their own low-information chunk.
MIN_SECTION_WORDS=40
# A CSV upload is grouped into sections of this many data rows for citation labeling.
CSV_ROWS_PER_SECTION=50
# A PDF with more pages than this is refused before parsing.
MAX_PDF_PAGES=2000
# Only this many text-less (scanned) pages of one PDF are OCR'd; the rest are skipped.
MAX_OCR_PAGES=100
# An XLSX workbook with more cells than this (all sheets together) is refused.
MAX_SPREADSHEET_CELLS=200000
# Seconds an upload may take to parse, in its own process, before it is stopped and
# the job fails. 0 parses inside the API process with no limit.
PARSE_TIMEOUT_SECONDS=300.0
# Chunks are embedded and upserted in batches of this size during ingestion, so a
# single huge document reports incremental job progress instead of one giant call.
INGEST_BATCH_SIZE=64
# Points written to Qdrant per upsert call (independent of the embedding batch above).
INGEST_UPSERT_BATCH_SIZE=256
# Upload bytes allowed queued or in progress at once (each accepted upload stays in
# memory until its ingest finishes). Past this, uploads get 503 + Retry-After instead
# of growing memory without bound. An empty backlog always admits one upload.
INGEST_MAX_PENDING_BYTES=536870912
# Finished background ingest jobs beyond this count are pruned oldest-first.
INGEST_JOBS_MAX_RETAINED=50
# Seconds the document listing is reused before a full re-read. Changes made by this
# API are applied at once either way; this only bounds how long one made by another
# process (a second worker, the eval harness) goes unseen.
DOCUMENT_LISTING_TTL_SECONDS=300.0
# "memory" (default): job status is lost on restart — a client polling a job whose
# process just restarted gets a 404 even if the ingest succeeded in Qdrant. "sqlite"
# persists it to JOB_STORE_PATH so that poll survives a restart; its directory must
# be writable (in Docker, keep it under ./data, the docrag_data volume — the API won't
# start otherwise).
JOB_STORE_BACKEND=memory
JOB_STORE_PATH=./data/jobs.db
# Empty (default): an uploaded document's raw bytes are discarded once ingestion is
# queued. Set to a directory to keep a copy of each upload and expose it via
# GET /documents/{filename}/original — same writable-directory/volume requirement as
# JOB_STORE_PATH. It also enables re-indexing from those originals
# (POST /documents/{filename}/reindex, or POST /documents/reindex for every document
# chunked by an older chunker) — only for documents uploaded while it was set.
RAW_DOCUMENT_DIR=
# With RAW_DOCUMENT_DIR: earlier versions of each original a re-upload keeps (listed by
# GET /documents/{f}/versions, re-indexed by POST /documents/{f}/versions/{v}/restore).
# 0 = none. Versions are never part of a backup.
RAW_DOCUMENT_VERSIONS=0
# false (default): no thumbs up/down answer-feedback capture (POST /feedback, read
# back with GET /feedback), no feedback buttons in the UI. Stores to
# FEEDBACK_STORE_PATH, its own sqlite3 file — independent of JOB_STORE_BACKEND, so
# this works whether or not that's set to sqlite. Same writable-directory/volume
# requirement as JOB_STORE_PATH.
FEEDBACK_ENABLED=false
FEEDBACK_STORE_PATH=./data/feedback.db
# Oldest ratings are pruned past this many rows, so an open POST /feedback (API_KEY
# unset) can't grow the file without bound.
FEEDBACK_MAX_ROWS=50000
# Log every question and summary (text, workspace, outcome, best passage score) to its
# own sqlite file, listed by GET /query-log (full key; ?uncovered=true for the ones the
# documents didn't answer). Off by default: it keeps what users typed. Never in a backup.
QUERY_LOG_ENABLED=false
QUERY_LOG_PATH=./data/query_log.db
QUERY_LOG_MAX_ROWS=20000

# CORS (fallback only — dev uses the Vite proxy, prod serves the frontend
# same-origin; only needed if a separately-running frontend calls this API
# directly, e.g. CORS_ALLOW_ORIGINS=["http://localhost:5173"])
CORS_ALLOW_ORIGINS=[]

# Where fastembed keeps downloaded models when running outside Docker (the image sets
# /home/app/.cache/fastembed). Unset, fastembed uses the OS temp directory, which a
# reboot clears — and the ~0.5 GB of models download again.
# An absolute path (no ~), e.g. FASTEMBED_CACHE_PATH=/Users/you/.cache/fastembed
# FASTEMBED_CACHE_PATH=

# docker compose only, read from .env (compose substitutes them; the values here are
# the defaults): extra uv extras built into the image (UV_EXTRAS=ocr for scanned PDFs,
# then `docker compose up --build`) and the API container's memory cap.
UV_EXTRAS=
API_MEM_LIMIT=4g
# Run a published release instead of building, once one is tagged: DOCRAG_VERSION=<version>
# with DOCRAG_PULL_POLICY=always pulls ghcr.io/jaswanth1524/retrieval-ai-platform:<version>.
# DOCRAG_VERSION=local
# DOCRAG_PULL_POLICY=build
# A fork's own published images (the repository is in the name):
# DOCRAG_IMAGE=ghcr.io/jaswanth1524/retrieval-ai-platform

# Optional: force the embedding + reranker models to load once at startup instead of
# lazily on the first request. Off by default — see AppSettings.warmup_models for why.
WARMUP_MODELS=false

# Per-query debug traces (retrieval candidates, rerank decisions, the full generation
# prompt, stage timings), kept in an in-memory ring buffer and exposed via GET /traces
# and GET /traces/{trace_id}. Lost on restart, same tradeoff as ingest job status.
TRACE_ENABLED=true
TRACE_MAX_RETAINED=100

# Conversation memory: the client sends recent turns with each question; when
# present, one extra LLM call rewrites the follow-up into a standalone retrieval
# query before embedding/search/rerank. Server stays stateless — no session store.
CONVERSATION_CONDENSE_ENABLED=true
CONVERSATION_MAX_HISTORY_MESSAGES=12
CONDENSE_MAX_TOKENS=128

# Multi-query expansion (opt-in): rewrite the query into N variants, retrieve each,
# RRF-fuse (same pinned k), then one rerank. Adds one LLM round-trip per question.
QUERY_EXPANSION_ENABLED=false
QUERY_EXPANSION_COUNT=3
QUERY_EXPANSION_MAX_TOKENS=192
# If an answer comes back with no [n] citations though sources were available, retry
# once with a stricter reminder to cite. Never loops.
CITATION_RETRY_ENABLED=true
# How the citations are added: "llm" (the retry above: a second full generation,
# about a minute on a local model), "backfill" (no LLM call: each answer sentence a
# source plainly states gets that source's [n]; marked "auto-cited"), "auto" (backfill
# first on Ollama/OpenAI-compatible, the LLM retry only when nothing matched; the LLM
# retry on hosted providers), or "off".
CITATION_RETRY_MODE=auto
# Suggested follow-up questions after an answer that cited its sources: one more LLM
# call per answer (seconds on a local model), so off by default. Up to FOLLOWUP_COUNT
# questions the cited passages can answer, sent after the answer.
FOLLOWUPS_ENABLED=false
FOLLOWUP_COUNT=3
FOLLOWUP_MAX_TOKENS=128

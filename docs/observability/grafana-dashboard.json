{
  "title": "DocRAG",
  "uid": "docrag",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "docrag"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Questions per minute, by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(docrag_questions_total[5m])) * 60",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Answer time p95 by stage",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(docrag_question_stage_seconds_bucket[10m])))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Answers by grounding status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(docrag_answers_total[15m])) * 60",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cache hits (answers, prompts)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(docrag_answer_cache_hits_total[15m]) * 60",
          "legendFormat": "answer cache"
        },
        {
          "refId": "B",
          "expr": "rate(docrag_prompt_cache_hits_total[15m]) * 60",
          "legendFormat": "prompt cache"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Indexing jobs by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome, error_type) (increase(docrag_ingest_jobs_total[1h]))",
          "legendFormat": "{{outcome}} {{error_type}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Ingest backlog",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "docrag_ingest_backlog_bytes",
          "legendFormat": "pending bytes"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Free disk per store",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "docrag_storage_free_bytes",
          "legendFormat": "{{setting}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Hours since the last good backup",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - docrag_backup_last_success_timestamp_seconds) / 3600",
          "legendFormat": "{{workspace}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Watched folder files",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "docrag_watch_files",
          "legendFormat": "{{folder}} {{state}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Documents per workspace",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "docrag_corpus_documents",
          "legendFormat": "{{workspace}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "LLM tokens per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(docrag_llm_tokens_total[5m])) * 60",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Prompts cut, unsupported claims",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(docrag_prompt_cuts_total[1h])",
          "legendFormat": "prompts cut"
        },
        {
          "refId": "B",
          "expr": "increase(docrag_unsupported_claims_total[1h])",
          "legendFormat": "unsupported claims"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Failed indexing jobs by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (increase(docrag_ingest_job_failures_total[1h]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "URL refreshes overdue",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "docrag_url_refresh_overdue",
          "legendFormat": "overdue"
        }
      ]
    }
  ]
}
